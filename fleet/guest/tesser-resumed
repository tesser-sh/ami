#!/bin/bash
# The host's line into the guest, on vsock port 1024: one command per
# connection. resumed: the clock jumped over a snapshot, boxd re-syncs.
# ready: a template has settled. personalize: a box restored from a template
# takes its own address, entropy, machine id, ssh host keys, and boots as a
# box.
# A box reads its template's memory from its host's page cache and its own
# disk cold, so a template caches what a box runs right after personalize.
warm() {
  local node=/usr/local/fnm/aliases/default/bin/node b p
  cat "$(readlink -f "$node")" > /dev/null
  python3 -c 'import fcntl, os, json' 2>/dev/null
  for b in "$node" curl sudo dmsetup mount umount findmnt blockdev dd cp install mkdir systemd-run systemctl python3 ssh-keygen ip git rsync nbd-client; do
    p=$(command -v "$b") || continue
    cat "$p" $(ldd "$p" 2>/dev/null | awk '$3 ~ /^\// { print $3 }') > /dev/null 2>&1
  done
  cat /usr/local/bin/tesser-verify-boxd > /dev/null
}
read -r cmd arg ip seed mid || exit 0
case "$cmd" in
  resumed)
    date -u -s "@$arg" >/dev/null
    systemctl kill -s USR2 --kill-whom=main tesser-boxd 2>/dev/null || true
    echo ok ;;
  ready)
    systemctl is-system-running --wait >/dev/null 2>&1 || true
    warm > /dev/null 2>&1
    sync
    echo ok ;;
  personalize)
    [ -e /run/tesser/template ] || { echo "not a template"; exit 0; }
    [[ "$mid" =~ ^[0-9a-f]{32}$ ]] || { echo "bad machine id"; exit 0; }
    date -u -s "@$arg" >/dev/null
    echo "$seed" > /dev/urandom
    python3 -c 'import fcntl, os; fd = os.open("/dev/urandom", os.O_WRONLY); fcntl.ioctl(fd, 0x5207); os.close(fd)' || { echo "reseed failed"; exit 0; }
    umount /etc/machine-id 2>/dev/null || true
    echo "$mid" > /etc/machine-id
    systemctl restart --no-block systemd-journald
    ip addr flush dev eth0
    ip addr add "$ip/9" dev eth0
    ip route replace default via 10.128.0.1 dev eth0 onlink
    rm -f /etc/ssh/ssh_host_*
    /usr/local/sbin/tesser-hostkeys
    rm /run/tesser/template
    systemctl start --no-block tesser-boot
    echo ok ;;
  ping) echo pong ;;
esac
