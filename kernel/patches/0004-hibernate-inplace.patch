+/*
+ * Pages read from where they are: the anonymous memory of address spaces whose
+ * every user is a frozen task. Nothing writes such a page until the image has
+ * been read: its owners can't run, no kernel thread has the mm, and a page is
+ * only taken when its references are exactly its mappings (plus the swap
+ * cache), so nobody holds it for I/O, a pin or a GUP write. The reference taken
+ * on it keeps reclaim, compaction, migration, khugepaged and KSM from freeing,
+ * moving or merging it. The snapshot doesn't copy these pages, so making an
+ * image needs free memory only for everything else. The maps are ordinary
+ * kernel memory, so they are in the image too, and the resumed kernel drops
+ * the same references in swsusp_free().
+ */
+static unsigned long *inplace_map, *inplace_held;
+static unsigned long inplace_max, nr_inplace, nr_inplace_image;
+bool hibernate_inplace_held, hibernate_inplace_torn;
+
+static inline bool page_inplace(unsigned long pfn)
+{
+	return inplace_map && pfn < inplace_max && test_bit(pfn, inplace_map);
+}
+
+static bool inplace_folio_ok(struct folio *folio)
+{
+	int expected;
+
+	if (!folio_test_anon(folio) || folio_test_ksm(folio) ||
+	    folio_test_hugetlb(folio) || folio_is_zone_device(folio) ||
+	    folio_test_highmem(folio))
+		return false;
+	expected = folio_mapcount(folio);
+	if (folio_test_swapcache(folio))
+		expected += folio_nr_pages(folio);
+	return folio_ref_count(folio) == expected;
+}
+
+static void inplace_mark(struct page *page)
+{
+	struct folio *folio = page_folio(page);
+	unsigned long pfn = page_to_pfn(page), head = folio_pfn(folio);
+
+	if (pfn >= inplace_max || head >= inplace_max || PageHWPoison(page) ||
+	    test_bit(pfn, inplace_map))
+		return;
+	if (!test_bit(head, inplace_held)) {
+		if (!inplace_folio_ok(folio))
+			return;
+		folio_get(folio);
+		__set_bit(head, inplace_held);
+	}
+	__set_bit(pfn, inplace_map);
+	nr_inplace++;
+}
+
+static int inplace_pmd(pmd_t *pmd, unsigned long addr, unsigned long end,
+		       struct mm_walk *walk)
+{
+	struct vm_area_struct *vma = walk->vma;
+	pte_t *start, *pte;
+	spinlock_t *ptl;
+
+	walk->action = ACTION_CONTINUE;
+	ptl = pmd_trans_huge_lock(pmd, vma);
+	if (ptl) {
+		pmd_t pmdv = *pmd;
+		struct page *page = pmd_present(pmdv) ?
+			vm_normal_page_pmd(vma, addr & HPAGE_PMD_MASK, pmdv) : NULL;
+
+		if (page)
+			for (page += (addr & ~HPAGE_PMD_MASK) >> PAGE_SHIFT;
+			     addr < end; addr += PAGE_SIZE, page++)
+				inplace_mark(page);
+		spin_unlock(ptl);
+		return 0;
+	}
+	start = pte = pte_offset_map_lock(vma->vm_mm, pmd, addr, &ptl);
+	if (!pte) {
+		walk->action = ACTION_AGAIN;
+		return 0;
+	}
+	for (; addr < end; pte++, addr += PAGE_SIZE) {
+		pte_t ptent = ptep_get(pte);
+		struct page *page;
+
+		if (!pte_present(ptent))
+			continue;
+		page = vm_normal_page(vma, addr, ptent);
+		if (page)
+			inplace_mark(page);
+	}
+	pte_unmap_unlock(start, ptl);
+	return 0;
+}
+
+static int inplace_test(unsigned long start, unsigned long end, struct mm_walk *walk)
+{
+	return walk->vma->vm_flags & (VM_IO | VM_PFNMAP) ? 1 : 0;
+}
+
+static const struct mm_walk_ops inplace_ops = {
+	.pmd_entry = inplace_pmd,
+	.test_walk = inplace_test,
+	.walk_lock = PGWALK_RDLOCK,
+};
+
+/**
+ * hibernate_release_inplace - Drop the references the in-place pages hold.
+ */
+void hibernate_release_inplace(void)
+{
+	unsigned long pfn;
+
+	if (irqs_disabled())
+		return;
+	WRITE_ONCE(hibernate_inplace_held, false);
+	if (inplace_held)
+		for_each_set_bit(pfn, inplace_held, inplace_max)
+			folio_put(page_folio(pfn_to_page(pfn)));
+	vfree(inplace_held);
+	vfree(inplace_map);
+	inplace_held = NULL;
+	inplace_map = NULL;
+	nr_inplace = 0;
+	nr_inplace_image = 0;
+}
+
+struct inplace_mm {
+	struct mm_struct *mm;
+	bool skip;
+};
+
+/**
+ * hibernate_mark_inplace - Leave frozen tasks' anonymous memory out of the copy.
+ *
+ * Called with user space frozen, by the one task that is not. An address
+ * space is read in place only if every task using it is frozen and none of
+ * them is a kernel thread (kthread_use_mm: vhost, io_uring of old, drivers);
+ * any other is copied as before. Returns the number of pages the image will
+ * read from where they are.
+ */
+long hibernate_mark_inplace(void)
+{
+	struct task_struct *g, *t;
+	struct inplace_mm *mms;
+	unsigned long n = 0, cap, i, walked = 0, skipped = 0, busy = 0;
+	bool overflow = false;
+	ktime_t start = ktime_get();
+
+	hibernate_release_inplace();
+	lru_add_drain_all();
+	inplace_max = max_pfn;
+	inplace_map = vzalloc(BITS_TO_LONGS(inplace_max) * sizeof(long));
+	inplace_held = vzalloc(BITS_TO_LONGS(inplace_max) * sizeof(long));
+	cap = nr_threads + 64;
+	mms = kvcalloc(cap, sizeof(*mms), GFP_KERNEL);
+	if (!inplace_map || !inplace_held || !mms) {
+		kvfree(mms);
+		hibernate_release_inplace();
+		return -ENOMEM;
+	}
+	WRITE_ONCE(hibernate_inplace_torn, false);
+	WRITE_ONCE(hibernate_inplace_held, true);
+	read_lock(&tasklist_lock);
+	for_each_process_thread(g, t) {
+		struct mm_struct *mm;
+		bool ok;
+
+		task_lock(t);
+		mm = t->mm;
+		ok = !(t->flags & PF_KTHREAD) && frozen(t);
+		if (mm && mm != current->mm) {
+			ok = ok && !mm_has_notifiers(mm);
+			for (i = n; i > 0 && mms[i - 1].mm != mm; i--)
+				;
+			if (i > 0) {
+				mms[i - 1].skip |= !ok;
+			} else if (n == cap) {
+				overflow = true;
+			} else if (mmget_not_zero(mm)) {
+				mms[n].mm = mm;
+				mms[n++].skip = !ok;
+			}
+		}
+		task_unlock(t);
+		if (overflow)
+			break;
+	}
+	read_unlock(&tasklist_lock);
+	for (i = 0; i < n; i++) {
+		int tries;
+
+		if (overflow || mms[i].skip) {
+			skipped++;
+		} else {
+			for (tries = 0; tries < 50 && !mmap_read_trylock(mms[i].mm); tries++)
+				msleep(1);
+			if (tries < 50) {
+				walk_page_range(mms[i].mm, 0, mms[i].mm->task_size, &inplace_ops, NULL);
+				mmap_read_unlock(mms[i].mm);
+				walked++;
+			} else {
+				busy++;
+			}
+		}
+		mmput(mms[i].mm);
+	}
+	kvfree(mms);
+	pr_info("%lu pages in place, from %lu address spaces (%lu with a task not frozen, %lu busy%s), marked in %lld ms\n",
+		nr_inplace, walked, skipped, busy, overflow ? ", too many tasks" : "",
+		ktime_ms_delta(ktime_get(), start));
+	return nr_inplace;
+}
