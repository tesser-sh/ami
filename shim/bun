#!/bin/bash
# bun at the version the repo pins: the nearest .bun-version, or
# "packageManager": "bun@<version>" in a package.json, walking up from the
# working directory. A pinned version installs on first use under
# ~/.bun/versions, where a sibling box's warm-up can bring it along; with no
# pin, the image's own bun runs.
set -euo pipefail
root=/usr/local/bun
releases=https://github.com/oven-sh/bun/releases/download

pin=""
want=""
manager='"packageManager"[[:space:]]*:[[:space:]]*"bun@([^"+]*)'
dir=$PWD
while :; do
  if [ -f "$dir/.bun-version" ]; then
    pin=$dir/.bun-version
    want=$(<"$pin")
    break
  fi
  if [ -f "$dir/package.json" ] && [[ $(<"$dir/package.json") =~ $manager ]]; then
    pin=$dir/package.json
    want=${BASH_REMATCH[1]}
    break
  fi
  [ -n "$dir" ] || break
  dir=${dir%/*}
done

want=${want//[[:space:]]/}
want=${want#bun-}
want=${want#v}
default=$(<"$root/default")
version=$default
if [[ $want =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  version=$want
elif [ -n "$pin" ]; then
  echo "bun: $pin pins \"$want\", not an exact version; running $version" >&2
fi

if [ "${0##*/}" = bunx ]; then set -- x "$@"; fi
home=$root
if [ "$version" != "$default" ]; then home=${HOME:?}/.bun; fi
bin=$home/versions/$version/bin/bun
if [ ! -x "$bin" ]; then
  case $(uname -m) in
    x86_64) arch=x64 ;;
    aarch64 | arm64) arch=aarch64 ;;
    *) echo "bun: no release for $(uname -m)" >&2; exit 1 ;;
  esac
  echo "bun: installing $version${pin:+, pinned by $pin}" >&2
  mkdir -p "$home"
  tmp=$(mktemp -d "$home/.install-$version.XXXXXX")
  if ! curl -fsSL --retry 3 -o "$tmp/bun.zip" "$releases/bun-v$version/bun-linux-$arch.zip" ||
    ! unzip -qj "$tmp/bun.zip" "bun-linux-$arch/bun" -d "$tmp"; then
    rm -rf "$tmp"
    echo "bun: could not install $version" >&2
    exit 1
  fi
  mkdir -p "${bin%/*}"
  chmod 755 "$tmp/bun" "$home/versions" "$home/versions/$version" "${bin%/*}"
  mv -f "$tmp/bun" "$bin"
  rm -rf "$tmp"
fi
exec "$bin" "$@"
