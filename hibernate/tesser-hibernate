#!/bin/bash
# acpid runs this for every sleep button event, which is how EC2 asks a box
# to hibernate. Ubuntu's handler only acts on SBTN and EC2 sometimes sends
# LNXSLPBN instead; a missed event leaves the instance stopping for 20 minutes
# and then cold boots it.
set -uo pipefail
power=/sys/power
meminfo=/proc/meminfo
swaps=/proc/swaps
swap=/swap-hibinit
run=/run/tesser-hibernate
cache=/var/lib/tesser/pagecache
pagecache=/usr/local/lib/tesser/pagecache
home=/var/lib/tesser/home
sysctls=/etc/sysctl.d/99-tesser.conf
debounce=20

say() { logger -t tesser-hibernate "$*"; }

exec 9> "$run.lock"
flock -n 9 || exit 0
# acpid queues events behind a running action, so a duplicate press arrives
# right after the resume.
if [[ -e $run.resumed ]] && (($(date +%s) - $(stat -c %Y "$run.resumed") < debounce)); then
  say "ignoring $* right after a resume"
  exit 0
fi
say "hibernating on $*"

# Only about half of RAM fits in the image; the kernel drops page cache to
# make room. Remember what was cached and read it back after the resume. A box
# started from a repo snapshot keeps /home/ubuntu on its own volume.
mkdir -p "$(dirname "$cache")"
roots=(/)
mountpoint -q "$home" && roots+=("$home")
listed=1
for root in "${roots[@]}"; do
  timeout 60 python3 "$pagecache" snapshot "$root" "$swap" || listed=0
done > "$cache.new"
if ((listed)); then
  mv "$cache.new" "$cache"
else
  rm -f "$cache.new" "$cache"
fi
# Keep anonymous memory in the image rather than swapping it out to EBS. The
# kernel copies the image in memory before writing it, so it holds at most
# about half of RAM; asking for all of it fails outright once the box uses
# more than its free memory, while just under half makes the kernel drop page
# cache down to that.
sysctl -q -w vm.swappiness=1
awk '/^MemTotal:/ { print int($2 * 1024 * 0.45) }' "$meminfo" > "$power/image_size"
# The image goes to the swap file. Priority 0 keeps it below zram once the box
# is back, so everyday swapping stays in memory.
grep -q "^$swap " "$swaps" || swapon --priority=0 "$swap"
sync

if echo disk > "$power/state"; then
  touch "$run.resumed"
  sysctl -q -p "$sysctls"
  say "resumed"
  [[ -s $cache ]] && systemd-run --no-block --collect --unit=tesser-pagecache python3 "$pagecache" reload "$cache"
  exit 0
fi
# A box that can't hibernate stops instead of waiting out EC2's 20 minutes.
sysctl -q -p "$sysctls"
say "hibernate failed; powering off"
systemctl poweroff
